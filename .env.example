# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# The publishable key (formerly "anon key") is safe to expose to browsers:
# it can only do what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Do NOT add the service role / secret key here. This app never needs it.
